<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_LeaveRequest"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.40.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.10.0">

  <bpmn:process id="leave-request" name="Leave request" isExecutable="true">

    <bpmn:startEvent id="StartEvent_LeaveRequested" name="Leave requested">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ValidateLeave" name="Validate leave request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-leave" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_RequestValid" name="Request valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_ToValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ManagerApproval" name="Manager approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="leave-approval" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_ManagerRejected">
      <bpmn:incoming>Flow_ToApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_FinalizeApproved" name="Finalize as approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finalize-leave" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;APPROVED&#34;" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ManagerApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_LeaveApproved" name="Leave approved">
      <bpmn:incoming>Flow_ToEndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_MergeRejected" name="Merge">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:incoming>Flow_ManagerRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinalizeRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_FinalizeRejected" name="Finalize as rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finalize-leave" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;REJECTED&#34;" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFinalizeRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_LeaveRejected" name="Leave rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="StartEvent_LeaveRequested" targetRef="Task_ValidateLeave" />
    <bpmn:sequenceFlow id="Flow_ToValidGateway" sourceRef="Task_ValidateLeave" targetRef="Gateway_RequestValid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Yes" sourceRef="Gateway_RequestValid" targetRef="Task_ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="No" sourceRef="Gateway_RequestValid" targetRef="Gateway_MergeRejected" />
    <bpmn:sequenceFlow id="Flow_ToApprovedGateway" sourceRef="Task_ManagerApproval" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_ManagerApproved" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_FinalizeApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerRejected" name="No" sourceRef="Gateway_Approved" targetRef="Gateway_MergeRejected" />
    <bpmn:sequenceFlow id="Flow_ToEndApproved" sourceRef="Task_FinalizeApproved" targetRef="EndEvent_LeaveApproved" />
    <bpmn:sequenceFlow id="Flow_ToFinalizeRejected" sourceRef="Gateway_MergeRejected" targetRef="Task_FinalizeRejected" />
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Task_FinalizeRejected" targetRef="EndEvent_LeaveRejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="leave-request">

      <bpmndi:BPMNShape id="StartEvent_LeaveRequested_di" bpmnElement="StartEvent_LeaveRequested">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="245" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateLeave_di" bpmnElement="Task_ValidateLeave">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RequestValid_di" bpmnElement="Gateway_RequestValid" isMarkerVisible="true">
        <dc:Bounds x="395" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="384" y="165" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManagerApproval_di" bpmnElement="Task_ManagerApproval">
        <dc:Bounds x="500" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="655" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="653" y="165" width="54" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FinalizeApproved_di" bpmnElement="Task_FinalizeApproved">
        <dc:Bounds x="760" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LeaveApproved_di" bpmnElement="EndEvent_LeaveApproved">
        <dc:Bounds x="912" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="892" y="245" width="76" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeRejected_di" bpmnElement="Gateway_MergeRejected" isMarkerVisible="true">
        <dc:Bounds x="655" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="664" y="402" width="32" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FinalizeRejected_di" bpmnElement="Task_FinalizeRejected">
        <dc:Bounds x="760" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LeaveRejected_di" bpmnElement="EndEvent_LeaveRejected">
        <dc:Bounds x="912" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="894" y="395" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToValidate_di" bpmnElement="Flow_ToValidate">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToValidGateway_di" bpmnElement="Flow_ToValidGateway">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="445" y="220" />
        <di:waypoint x="500" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="463" y="202" width="19" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="420" y="245" />
        <di:waypoint x="420" y="370" />
        <di:waypoint x="655" y="370" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="300" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApprovedGateway_di" bpmnElement="Flow_ToApprovedGateway">
        <di:waypoint x="600" y="220" />
        <di:waypoint x="655" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproved_di" bpmnElement="Flow_ManagerApproved">
        <di:waypoint x="705" y="220" />
        <di:waypoint x="760" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="723" y="202" width="19" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerRejected_di" bpmnElement="Flow_ManagerRejected">
        <di:waypoint x="680" y="245" />
        <di:waypoint x="680" y="345" />
        <bpmndi:BPMNLabel><dc:Bounds x="688" y="288" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndApproved_di" bpmnElement="Flow_ToEndApproved">
        <di:waypoint x="860" y="220" />
        <di:waypoint x="912" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToFinalizeRejected_di" bpmnElement="Flow_ToFinalizeRejected">
        <di:waypoint x="705" y="370" />
        <di:waypoint x="760" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndRejected_di" bpmnElement="Flow_ToEndRejected">
        <di:waypoint x="860" y="370" />
        <di:waypoint x="912" y="370" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
